{
    "name": "nexora",
    "private": true,
    "version": "1.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "lint": "eslint .",
        "test": "node --test",
        "db:migrate:local": "wrangler d1 migrations apply nexora-db --local",
        "admin:create:local": "node scripts/create-admin.mjs",
        "admin:create:remote": "node scripts/create-admin-remote.mjs",
        "storage:mount:create:remote": "node scripts/create-storage-mount-remote.mjs",
        "preview": "pnpm run build && wrangler pages dev",
        "deploy": "pnpm run build && wrangler pages deploy",
        "cf-typegen": "wrangler types",
        "log": "pnpm exec wrangler pages deployment tail",
        "migrate": "pnpm exec wrangler d1 migrations list nexora-db --remote",
        "migrate-apply": "pnpm exec wrangler d1 migrations apply nexora-db --remote"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@fontsource-variable/inter": "^5.3.0",
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/react-query": "^5.105.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.2.1",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "lucide-react": "^1.66.0",
        "shadcn": "^4.23.0",
        "tailwindcss": "^4.3.3",
        "tw-animate-css": "^1.4.0",
        "vite": "^8.3.5",
        "wrangler": "^4.156.2"
    }
}
